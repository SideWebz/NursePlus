{
  "tasks": {
    "dev": "deno run --watch --env-file=.env --allow-net --allow-read --allow-env backend/main.ts",
    "start": "deno run --env-file=.env --allow-net --allow-read --allow-env backend/main.ts",
    "build": "deno check backend/main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "useTabs": false,
    "singleQuote": false,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
